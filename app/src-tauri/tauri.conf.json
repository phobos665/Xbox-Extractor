{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xbox ISO Batcher",
  "version": "0.1.0",
  "identifier": "net.phobos665.xbox-iso-batcher",
  "build": {
    "beforeDevCommand": "pnpm sidecar && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm sidecar && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Xbox ISO Batcher",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "List the titles on an original Xbox over FTP and stream them into ISOs",
    "category": "Utility",
    "license": "GPL-3.0-or-later",
    "copyright": "Copyright (C) 2026 Daniel Joyce",
    "externalBin": [
      "binaries/extract-xiso"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "mainBinaryName": "xbox-iso-batcher"
}